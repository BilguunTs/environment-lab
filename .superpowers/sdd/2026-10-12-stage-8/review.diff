+func test_overrides_keep_only_changed_keys(_pg) -> void:
+	var base := {"a": 1.0, "b": Color(1, 0, 0), "c": true}
+	var state := {"a": 1.0000001, "b": Color(0, 1, 0), "c": true}
+	check_eq(Presets.overrides(state, base).keys(), ["b"], "only the colour changed")
