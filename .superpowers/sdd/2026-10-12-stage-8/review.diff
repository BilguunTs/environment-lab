+	check(Presets.all(PATH).has("Moonlit"), "built-ins still load")
+
+
+func test_missing_file_means_builtins_only(_pg) -> void:
+	check_eq(Presets.all(PATH).size(), Presets.ALL.size(), "no user presets")
