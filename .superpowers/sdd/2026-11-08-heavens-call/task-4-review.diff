 	player.global_position = trail.point_at(progress) + Vector3.UP
 	player.velocity = Vector3.ZERO
 	var ahead := trail.point_at(minf(progress + 2.0 / trail.length(), 1.0)) - trail.point_at(progress)
 	if progress >= 1.0:
