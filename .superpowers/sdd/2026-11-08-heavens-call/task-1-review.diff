+class_name HeavensCall
+extends Node3D
+## "Heavens call": a tired girl climbs a foggy mountain trail to a summit reveal. This root owns
+## the level's state and its reset; the trail, mood, sound, vista and summit systems hook in here.
+
+## Seconds the screen takes to fade in from black at the start.
+const FADE_IN_SECONDS := 3.0
+
+@onready var player: Player = $Player
+@onready var follow_cam: FollowCamera = $GameplayCamera
+@onready var wind: Wind = $Wind
+@onready var _fade: ColorRect = $UI/Fade
+
+var _player_start: Transform3D
+var _fade_tween: Tween
+
+
+func _ready() -> void:
+	_player_start = player.global_transform
+	reset_scene()
+
+
+## Puts the girl back at the trail start, restarts the fade-in from black, and resets the mood
+## and the sequence (later tasks extend this).
+func reset_scene() -> void:
+	player.global_transform = _player_start
+	player.velocity = Vector3.ZERO
+	follow_cam.yaw_deg = 0.0
+	follow_cam.snap()
+	_restart_fade()
+
+
+func _restart_fade() -> void:
+	if _fade_tween:
+		_fade_tween.kill()
+	_fade.color.a = 1.0
+	_fade_tween = create_tween()
+	_fade_tween.tween_property(_fade, "color:a", 0.0, FADE_IN_SECONDS)
