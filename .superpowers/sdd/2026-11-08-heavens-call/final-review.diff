+		s += "height_from_origin = true\n\n"  # sway and shade from its own origin, not y = 0
+		printerr("%s/%s progress %.3f -> %.3f, %.1f m from centre" % [group, name, row[1],
+				_trail.progress_at(xf.origin), _trail.distance_to_centre(xf.origin)])
+	return s
