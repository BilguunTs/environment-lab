+        rows = []
+        for i, p in enumerate(pts):
+            d = (pts[min(i + 1, len(pts) - 1)] - pts[max(i - 1, 0)]).normalized()
+            side = d.cross(Vector((0, 0, 1)))
+            side = side.normalized() if side.length > 1e-4 else Vector((1, 0, 0))
