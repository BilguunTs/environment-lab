 def godot_xform(pos, yaw=0.0, roll=0.0):
     """Blender matrix for a Godot node transform (Ry(yaw) * Rz(roll), Y up)."""
     g = Matrix.Rotation(yaw, 3, "Y") @ Matrix.Rotation(roll, 3, "Z")
