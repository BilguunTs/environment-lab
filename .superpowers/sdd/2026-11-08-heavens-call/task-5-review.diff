+        faces = list({f for x in new for f in x.link_faces})
+        bmesh.ops.solidify(bm, geom=faces, thickness=thickness)
+        new = [x for x in bm.verts if x not in before]
+        bmesh.ops.transform(bm, matrix=matrix, verts=new)
