+@tool
+class_name Vista
+extends Node3D
+## The Heavens call summit vista: the world the fog opens on. Everything far is generated (one
+## faceted mesh per piece, internal children with no owner, so the scene file stays small); the
+## ovoos are authored children under `Ovoos`.
+##
+## - Steppe: a golden ground disc of `steppe_radius` at `steppe_y`, flat under the massif (it
+##   buries the square terrain's outer edge and skirt) and rolling further out. It dips under the
+##   lowest stretch of the trail so the foot is never under it.
+## - Ridges: three rings of low-poly ridges at `ring_radii`, darker and bluer with distance. They
+##   part toward -Z (the way she looks from the summit), so the steppe runs on into the mist
+##   there, with the mountains rising either side.
+## - Mist sea: MIST_LAYERS flat slabs of mist (assets/shaders/mist_sea.gdshader) between the
+##   steppe and the summit. A thin veil looking down, a solid sea toward the horizon, so the
+##   steppe's edge and the valleys vanish under it.
+## - Cloud deck: one more slab of the same shader high overhead, dark slate, for a stormy sky.
+##
+## `reveal` (0..1, driven by the summit sequence) opens the view: MoodDirector multiplies its fog
+## by fog_scale() and its ground mist by mist_scale(), tints its sky with horizon_tint() and
+## zenith_tint(), and the mist sea thins. At 0 the far world
+## isn't drawn at all (it can't show through the fog on the climb) and the mood is untouched.
+## No collision, and no shadows: the far pieces neither cast nor need them.
+
+## Mood fog left at reveal 1 (a fraction). Opened geometrically, pow(OPEN_FOG, reveal), so the
+## seen distance grows steadily rather than all at the end.
+const OPEN_FOG := 0.08
+## Ground mist (the Mist FogVolume around her) left at reveal 1.
+const OPEN_MIST := 0.12
+## Sky at full reveal (blended in by OPEN_TINT): the horizon cools to a blue-grey distance haze,
+## so the ridges fade bluer, and the zenith darkens toward storm.
+const OPEN_HORIZON := Color(0.56, 0.6, 0.67)
+const OPEN_ZENITH := Color(0.19, 0.22, 0.29)
+const OPEN_TINT := 0.6
+## Radius of the mist sea, past the steppe's edge; the camera must see this far.
+const MIST_RADIUS := 4500.0
+## Heights of the mist layers above the steppe, and their optical depth closed / open.
+const MIST_LAYERS := [
+	{"above": 30.0, "closed": 1.2, "open": 0.2},
+	{"above": 75.0, "closed": 0.9, "open": 0.09},
+]
+## Mist drift, noise-space units per second per unit of wind.
+const MIST_DRIFT := 0.004
+## The cloud deck: height above the steppe, optical depth, noise scale, colour (stormy slate),
+## drift relative to the mist.
+const CLOUD := {"above": 1200.0, "thickness": 0.4, "noise_scale": 0.0004, "color": Color(0.27, 0.29, 0.34), "drift": 3.0}
+## Rolling noise on the steppe, in metres, reached beyond ROLL_FROM.y metres from the centre.
+const ROLL := 28.0
+const ROLL_FROM := Vector2(260.0, 1200.0)
+## The steppe stays this far under the trail, flat within FOOT_FLAT metres of it and rising at
+## FOOT_SLOPE beyond.
+const FOOT_CLEAR := 3.0
+const FOOT_FLAT := 15.0
+const FOOT_SLOPE := 0.25
+## Ridge rings: crest height range above the steppe, the gap toward -Z (angle where it starts to
+## close, angle where it is fully closed, crest height left in it) and the colour.
+const RINGS := [
+	{"segments": 160, "low": 40.0, "high": 210.0, "gap": Vector3(0.45, 1.15, 10.0), "color": Color(0.22, 0.23, 0.23)},
+	{"segments": 200, "low": 120.0, "high": 430.0, "gap": Vector3(0.3, 0.8, 20.0), "color": Color(0.17, 0.2, 0.26)},
+	{"segments": 240, "low": 250.0, "high": 800.0, "gap": Vector3(0.12, 0.5, 60.0), "color": Color(0.13, 0.17, 0.25)},
+]
+## Profile across a ridge (fraction of the depth, fraction of the crest height).
+const PROFILE := [Vector2(0.0, 0.0), Vector2(0.2, 0.32), Vector2(0.38, 0.72), Vector2(0.5, 1.0),
+	Vector2(0.63, 0.68), Vector2(0.8, 0.3), Vector2(1.0, 0.0)]
+
+## 0 = hidden behind the mood's fog, 1 = fully open.
+@export_range(0.0, 1.0) var reveal := 0.0:
+	set(value):
+		reveal = clampf(value, 0.0, 1.0)
+		_apply_reveal()
+@export var steppe_y := 3.0:
+	set(value):
+		steppe_y = value
+		_queue_rebuild()
+@export var steppe_radius := 3000.0:
+	set(value):
+		steppe_radius = value
+		_queue_rebuild()
+## Radii of the three ridge rings (their crests), metres from this node.
+@export var ring_radii := PackedFloat32Array([760.0, 1400.0, 2250.0]):
+	set(value):
+		ring_radii = value
+		_queue_rebuild()
+@export var seed := 11:
+	set(value):
+		seed = value
+		_queue_rebuild()
+@export var steppe_color := Color(0.72, 0.56, 0.26)
+## The trail, so the steppe can dip under its foot.
+@export var trail: Trail:
+	set(value):
+		trail = value
+		_queue_rebuild()
+## Optional: the mist sea takes its horizon colour from this environment's fog.
+@export var world_environment: WorldEnvironment
+## Optional: the mist sea drifts with this wind.
+@export var wind: Wind
+
+## Parent of everything generated far away; hidden while reveal is 0.
+var far: Node3D
+
+var _roll: FastNoiseLite
+var _patch: FastNoiseLite
+var _foot := PackedVector3Array()  # trail points low enough to need the dip
+var _mist: Array[ShaderMaterial] = []
+var _mist_offset := Vector2.ZERO
+var _cloud: ShaderMaterial
+var _rebuild_queued := false
+var _noise_ready := false
+
+
+func _ready() -> void:
+	rebuild()
+
+
+func _process(delta: float) -> void:
+	if far == null or not far.visible:
+		return
+	if wind:
+		_mist_offset -= wind.vector() * wind.strength * MIST_DRIFT * delta
+	var horizon := Color(0.5, 0.5, 0.52)
+	if world_environment and world_environment.environment:
+		horizon = world_environment.environment.fog_light_color
+	for m in _mist:
+		m.set_shader_parameter("offset", _mist_offset)
+		m.set_shader_parameter("horizon_color", horizon)
+		m.set_shader_parameter("color", horizon.lerp(Color(0.88, 0.9, 0.93), 0.6))
+	if _cloud:
+		_cloud.set_shader_parameter("offset", _mist_offset * CLOUD.drift)
+		_cloud.set_shader_parameter("horizon_color", horizon)
+		_cloud.set_shader_parameter("color", CLOUD.color)
+
+
+## How much of the mood's fog is left (1 = all of it at reveal 0).
+func fog_scale() -> float:
+	return pow(OPEN_FOG, reveal)
+
+
+## How much of the mood's ground mist is left.
+func mist_scale() -> float:
+	return lerpf(1.0, OPEN_MIST, reveal)
+
+
+## The mood's horizon (fog, background) colour as the reveal leaves it.
+func horizon_tint(c: Color) -> Color:
+	return c.lerp(OPEN_HORIZON, OPEN_TINT * reveal)
+
+
+## The mood's zenith colour as the reveal leaves it.
+func zenith_tint(c: Color) -> Color:
+	return c.lerp(OPEN_ZENITH, OPEN_TINT * reveal)
+
+
+## How far the camera must see to reach the edge of the mist sea.
+func horizon_distance() -> float:
+	return MIST_RADIUS
+
+
+## The steppe's height at world `xz` (the mesh is this, sampled on its rings).
+func steppe_height_at(xz: Vector2) -> float:
+	_ensure_noise()
+	var local := xz - Vector2(global_position.x, global_position.z)
+	var r := local.length()
+	var y := steppe_y + global_position.y
+	y += ROLL * _roll.get_noise_2d(local.x, local.y) * smoothstep(ROLL_FROM.x, ROLL_FROM.y, r)
+	for p in _foot:
+		var d := Vector2(p.x, p.z).distance_to(xz)
+		y = minf(y, p.y - FOOT_CLEAR + FOOT_SLOPE * maxf(d - FOOT_FLAT, 0.0))
+	return y
+
+
+## Regenerates the steppe, the ridges, the mist sea and the cloud deck.
+func rebuild() -> void:
+	_rebuild_queued = false
+	if not is_inside_tree():
+		return
+	if is_instance_valid(far):
+		remove_child(far)
+		far.queue_free()
+	_mist.clear()
+	_noise_ready = false
+	_ensure_noise()
+	_find_foot()
+	far = Node3D.new()
+	far.name = "Far"
+	add_child(far, false, Node.INTERNAL_MODE_BACK)
+	far.add_child(_mesh_node("Steppe", _steppe_mesh()))
+	for i in mini(ring_radii.size(), RINGS.size()):
+		far.add_child(_mesh_node("Ridges%d" % (i + 1), _ring_mesh(i)))
+	var noise_tex := NoiseTexture2D.new()
+	noise_tex.width = 256
+	noise_tex.height = 256
+	noise_tex.seamless = true
+	noise_tex.generate_mipmaps = true
+	var n := FastNoiseLite.new()
+	n.seed = seed + 5
+	n.frequency = 0.02
+	n.fractal_octaves = 3
+	noise_tex.noise = n
+	for i in MIST_LAYERS.size():
+		var mat := ShaderMaterial.new()
+		mat.shader = preload("res://assets/shaders/mist_sea.gdshader")
+		mat.set_shader_parameter("noise_tex", noise_tex)
+		mat.set_shader_parameter("noise_scale", 0.0007 * (1.0 + 0.5 * i))
+		mat.render_priority = i
+		_mist.append(mat)
+		var node := _mesh_node("Mist%d" % (i + 1), _disc_mesh(MIST_RADIUS, 72))
+		node.position.y = steppe_y + MIST_LAYERS[i].above
+		node.material_override = mat
+		far.add_child(node)
+	# The storm's cloud deck overhead: the same slab shader, dark, thickening toward the horizon.
+	_cloud = ShaderMaterial.new()
+	_cloud.shader = preload("res://assets/shaders/mist_sea.gdshader")
+	_cloud.set_shader_parameter("noise_tex", noise_tex)
+	_cloud.set_shader_parameter("noise_scale", CLOUD.noise_scale)
+	_cloud.set_shader_parameter("thickness", CLOUD.thickness)
+	_cloud.set_shader_parameter("soft", 1.0)
+	_cloud.set_shader_parameter("banks_range", Vector2(0.35, 1.7))
+	_cloud.set_shader_parameter("rim_fade", Vector2(MIST_RADIUS * 0.55, MIST_RADIUS * 0.97))
+	var deck := _mesh_node("Clouds", _disc_mesh(MIST_RADIUS, 72))
+	deck.position.y = steppe_y + CLOUD.above
+	deck.material_override = _cloud
+	far.add_child(deck)
+	_apply_reveal()
+	_process(0.0)
+
+
+func _apply_reveal() -> void:
+	if far:
+		far.visible = reveal > 0.0
+	for i in _mist.size():
+		var layer: Dictionary = MIST_LAYERS[i]
+		_mist[i].set_shader_parameter("thickness", lerpf(layer.closed, layer.open, reveal))
+
+
+func _queue_rebuild() -> void:
+	if _rebuild_queued or not is_inside_tree():
+		return
+	_rebuild_queued = true
+	rebuild.call_deferred()
+
+
+func _ensure_noise() -> void:
+	if _noise_ready:
+		return
+	_noise_ready = true
+	_roll = FastNoiseLite.new()
+	_roll.seed = seed
+	_roll.frequency = 1.0 / 900.0
+	_roll.fractal_octaves = 3
+	_patch = FastNoiseLite.new()
+	_patch.seed = seed + 1
+	_patch.frequency = 1.0 / 260.0
+	_patch.fractal_octaves = 2
+	if _foot.is_empty():
+		_find_foot()
+
+
+func _find_foot() -> void:
+	_foot = PackedVector3Array()
+	if trail == null or trail.curve == null or trail.length() <= 0.0:
+		return
+	var top := steppe_y + global_position.y + FOOT_CLEAR + 1.0
+	var count := int(trail.length() / 4.0)
+	for i in count + 1:
+		var p := trail.point_at(float(i) / count)
+		if p.y < top:
+			_foot.append(p)
+
+
+func _mesh_node(node_name: String, mesh: ArrayMesh) -> MeshInstance3D:
+	var node := MeshInstance3D.new()
+	node.name = node_name
+	node.mesh = mesh
+	node.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
+	return node
+
+
+## Faceted triangles: every face its own normal, colours per vertex.
+func _faceted(verts: PackedVector3Array, cols: PackedColorArray) -> ArrayMesh:
+	var normals := PackedVector3Array()
+	normals.resize(verts.size())
+	for i in range(0, verts.size(), 3):
+		var nrm := (verts[i + 2] - verts[i]).cross(verts[i + 1] - verts[i]).normalized()
+		normals[i] = nrm
+		normals[i + 1] = nrm
+		normals[i + 2] = nrm
+	var arrays := []
+	arrays.resize(Mesh.ARRAY_MAX)
+	arrays[Mesh.ARRAY_VERTEX] = verts
+	arrays[Mesh.ARRAY_NORMAL] = normals
+	arrays[Mesh.ARRAY_COLOR] = cols
+	var mesh := ArrayMesh.new()
+	mesh.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, arrays)
+	var mat := StandardMaterial3D.new()
+	mat.vertex_color_use_as_albedo = true
+	mat.vertex_color_is_srgb = true
+	mat.roughness = 1.0
+	mesh.surface_set_material(0, mat)
+	return mesh
+
+
+## A grid of rows x columns (columns wrap around) as faceted quads, upward-facing.
+func _grid(points: Array[PackedVector3Array], colors: Array[PackedColorArray]) -> ArrayMesh:
+	var verts := PackedVector3Array()
+	var cols := PackedColorArray()
+	for r in points.size() - 1:
+		var a := points[r]
+		var b := points[r + 1]
+		var ca := colors[r]
+		var cb := colors[r + 1]
+		var n := a.size()
+		for j in n:
+			var k := (j + 1) % n
+			# Rows run outward and columns clockwise seen from above, so these face up.
+			verts.append_array([a[j], b[j], a[k], a[k], b[j], b[k]])
+			cols.append_array([ca[j], cb[j], ca[k], ca[k], cb[j], cb[k]])
+	return _faceted(verts, cols)
+
+
+func _steppe_mesh() -> ArrayMesh:
+	const RINGS_N := 60
+	const SEGMENTS := 160
+	var points: Array[PackedVector3Array] = []
+	var colors: Array[PackedColorArray] = []
+	var origin := Vector2(global_position.x, global_position.z)
+	for i in range(1, RINGS_N + 1):
+		var r := steppe_radius * pow(float(i) / RINGS_N, 1.8)
+		var row := PackedVector3Array()
+		var crow := PackedColorArray()
+		for j in SEGMENTS:
+			var a := TAU * (j + 0.5 * (i % 2)) / SEGMENTS
+			var local := Vector2(sin(a), -cos(a)) * r
+			var y := steppe_height_at(origin + local) - global_position.y
+			row.append(Vector3(local.x, y, local.y))
+			crow.append(_steppe_tint(local, y))
+		points.append(row)
+		colors.append(crow)
+	return _grid(points, colors)
+
+
+func _steppe_tint(local: Vector2, y: float) -> Color:
+	var n := _patch.get_noise_2d(local.x, local.y) * 0.7 + _patch.get_noise_2d(local.x * 3.7, local.y * 3.7) * 0.3
+	var c := steppe_color
+	if n < 0.0:
+		c = c.lerp(Color(0.42, 0.4, 0.2), smoothstep(0.0, -0.6, n))  # olive hollows
+	else:
+		c = c.lerp(Color(0.72, 0.58, 0.3), smoothstep(0.0, 0.6, n))  # pale dry grass
+	var hollow := clampf((steppe_y - y) / ROLL, -1.0, 1.0)
+	return c.darkened(0.15 * maxf(hollow, 0.0))
+
+
+func _ring_mesh(index: int) -> ArrayMesh:
+	var ring: Dictionary = RINGS[index]
+	var radius: float = ring_radii[index]
+	var depth := radius * 0.38
+	var segments: int = ring.segments
+	var peaks := FastNoiseLite.new()
+	peaks.seed = seed + 10 + index
+	peaks.frequency = 1.0
+	peaks.fractal_octaves = 3
+	var jitter := FastNoiseLite.new()
+	jitter.seed = seed + 20 + index
+	jitter.frequency = 9.0
+	var low := steppe_y - 25.0
+	var gap: Vector3 = ring.gap
+	var base_color: Color = ring.color
+	var points: Array[PackedVector3Array] = []
+	var colors: Array[PackedColorArray] = []
+	for p in PROFILE.size():
+		points.append(PackedVector3Array())
+		colors.append(PackedColorArray())
+	for j in segments:
+		var a := TAU * j / segments
+		var dir := Vector2(sin(a), -cos(a))
+		# Peaks: noise around the ring (sampled on a circle, so it wraps), sharpened.
+		var k := 3.0 + index * 1.5
+		var n := peaks.get_noise_2d(dir.x * k, dir.y * k)
+		var ridged := 1.0 - absf(peaks.get_noise_2d(dir.x * k * 2.3 + 40.0, dir.y * k * 2.3))
+		var t := clampf(0.45 + 1.1 * n + 0.45 * (ridged - 0.6), 0.0, 1.0)
+		var crest := steppe_y + lerpf(ring.low, ring.high, pow(t, 1.6))
+		var off := absf(wrapf(a, -PI, PI))
+		crest = lerpf(steppe_y + gap.z, crest, smoothstep(gap.x, gap.y, off))
+		var shift := jitter.get_noise_2d(dir.x, dir.y) * depth * 0.12
+		for p in PROFILE.size():
+			var f: Vector2 = PROFILE[p]
+			var wob := 0.0 if p == 0 or p == PROFILE.size() - 1 else jitter.get_noise_2d(dir.x * 3.0 + p, dir.y * 3.0) * 0.12
+			var h := clampf(f.y + wob, 0.0, 1.0)
+			var r := radius - depth * 0.5 + depth * f.x + (shift if p > 0 and p < PROFILE.size() - 1 else 0.0)
+			var y := lerpf(low, crest, h)
+			points[p].append(Vector3(dir.x * r, y, dir.y * r))
+			colors[p].append(_ridge_tint(index, base_color, y, crest, jitter.get_noise_2d(dir.x * 5.0, dir.y * 5.0 + p)))
+	return _grid(points, colors)
+
+
+func _ridge_tint(index: int, base: Color, y: float, crest: float, n: float) -> Color:
+	var c := base.lightened(0.06 * n)
+	var above := y - steppe_y
+	if index == 0:
+		# The near foothills keep a little of the steppe's gold low down.
+		c = c.lerp(steppe_color.darkened(0.25), 0.55 * (1.0 - smoothstep(40.0, 160.0, above)))
+	# Old snow on the highest crests of the far rings.
+	if index > 0 and above > 480.0 and y > crest - 120.0:
+		c = c.lerp(Color(0.62, 0.66, 0.74), 0.6 * smoothstep(480.0, 760.0, above))
+	return c
+
+
+func _disc_mesh(radius: float, segments: int) -> ArrayMesh:
+	var verts := PackedVector3Array()
+	for j in segments:
+		var a0 := TAU * j / segments
+		var a1 := TAU * (j + 1) / segments
+		verts.append_array([Vector3.ZERO, Vector3(sin(a0), 0.0, -cos(a0)) * radius, Vector3(sin(a1), 0.0, -cos(a1)) * radius])
+	var arrays := []
+	arrays.resize(Mesh.ARRAY_MAX)
+	arrays[Mesh.ARRAY_VERTEX] = verts
+	var mesh := ArrayMesh.new()
+	mesh.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, arrays)
+	return mesh
