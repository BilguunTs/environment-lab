@@ -0,0 +1,28 @@
+// Shared wind: the three globals published by scripts/environment/wind.gd, and the gust field
+// every wind-driven shader samples, so trees and grass lean in the same patches.
+global uniform float wind_strength;
+global uniform vec2 wind_direction;
+global uniform vec2 wind_offset;
+
+float wind_hash(vec2 p) {
+	return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453);
+}
+
+float wind_value_noise(vec2 p) {
+	vec2 i = floor(p);
+	vec2 f = fract(p);
+	f = f * f * (3.0 - 2.0 * f);
+	return mix(mix(wind_hash(i), wind_hash(i + vec2(1.0, 0.0)), f.x),
+			mix(wind_hash(i + vec2(0.0, 1.0)), wind_hash(i + vec2(1.0, 1.0)), f.x), f.y);
+}
+
+// Gust strength 0..1 at a world position: irregular patches (~20 m along the wind, ~40 m across
+// it, so fronts run across the wind) that travel downwind as wind_offset grows.
+float wind_gust(vec2 world_xz) {
+	vec2 p = world_xz - wind_offset;
+	vec2 along = wind_direction;
+	vec2 across = vec2(-along.y, along.x);
+	vec2 q = vec2(dot(p, along) / 20.0, dot(p, across) / 40.0);
+	float g = wind_value_noise(q) * 0.65 + wind_value_noise(q * 2.3 + vec2(7.3, 1.7)) * 0.35;
+	return clamp((g - 0.2) / 0.6, 0.0, 1.0);
+}
