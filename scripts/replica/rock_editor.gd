class_name RockEditor
extends Node2D
## 2D rock correction tool for a replica site (data/sites/<site>/).
##
## Reads build/ortho.png (background, runtime only — never imported or saved), build/rocks_detected.json
## and edits/rocks_edits.json; shows merge(detected, edits) over the ortho and writes ONLY
## edits/rocks_edits.json. build/rocks.json is regenerated by the Python side
## (replica.rocks.write_site_rocks) and is never read or written here.
##
## World units are metres in the site's local frame: 2D x = east (+X), 2D y = south (+Z), origin =
## site centre. Yaw is the long axis, clockwise from north (-Z), in [0, 180).
##
## Run: Godot --path . res://scenes/replica/rock_editor.tscn -- --site=data/sites/sumber
## Controls (also shown in the HUD):
##   wheel zoom · right/middle drag or WASD/arrows pan · F fit
##   click select · Del/X delete · Esc cancel/deselect
##   drag = long axis of a new rock, then move for the width and click to add (Esc cancels)
##   1-9 height n m, Shift+1-9 n+0.5 m, 0 = 10 m (selected rock; before a drag: the next new rock)
##   M + drag from rock foot to shadow tip: height from the shadow on the selected rock
##   O ortho on/off · L rock outlines on/off · Ctrl+S save (also saved on window close)

## replica/rocks.py PARAMS: the footprint height rule (height = width x ratio, the median
## height/width of the shadow-measured boulders once this many exist, capped at the 90th
## percentile of their heights, clamped to [HEIGHT_MIN, HEIGHT_MAX]).
const FOOTPRINT_HEIGHT_RATIO := 0.6
const FOOTPRINT_RATIO_MIN_SAMPLES := 20
const FOOTPRINT_CAP_PERCENTILE := 90.0
const HEIGHT_MIN := 0.3
const HEIGHT_MAX := 40.0
## Field order of a rock in the JSON files (replica/rocks.py _FIELDS).
const FIELDS: Array[String] = ["id", "x", "z", "length", "width", "yaw_deg", "height", "kind",
	"outline", "source", "height_source"]
## Clicks this close (m) outside a boulder's rectangle still pick it.
const PICK_MARGIN_M := 0.5
## Mouse travel (screen px) that turns a click into a drag.
const DRAG_PX := 4.0
const ZOOM_STEP := 1.25
const ZOOM_MIN := 0.05
const ZOOM_MAX := 40.0
const PAN_SPEED_PX := 900.0

const COLOUR_BOULDER := Color(1.0, 0.85, 0.1)
const COLOUR_MASS := Color(0.2, 0.9, 1.0)
const COLOUR_EDIT := Color(1.0, 0.35, 1.0)
const COLOUR_SELECTED := Color(1.0, 0.15, 0.1)
const COLOUR_PREVIEW := Color(0.3, 1.0, 0.3)

enum Mode { IDLE, PRESSED, AXIS, WIDTH, SHADOW }

var site_dir := ""
var core_m := 2000.0
var mpp := 0.5
var sun_elevation_deg := 45.0
var ortho_texture: ImageTexture
## Rocks as read from build/rocks_detected.json (dictionaries with FIELDS keys).
var detected: Array[Dictionary] = []
## The edits: rocks added, ids deleted (id -> true), field changes (id -> {field: value}).
var added: Array[Dictionary] = []
var deleted: Dictionary = {}
var changed: Dictionary = {}
## What is shown: merge(detected, edits), rebuilt after every edit.
var rocks: Array[Dictionary] = []
var selected_id := ""
var dirty := false
var show_ortho := true
var show_rocks := true
## Height (m) given to the next drawn rock; 0 = the footprint rule.
var next_height := 0.0
var status := ""

var _footprint_ratio := FOOTPRINT_HEIGHT_RATIO
var _footprint_cap := HEIGHT_MAX
var _mode := Mode.IDLE
var _shadow_armed := false
var _press_screen := Vector2.ZERO
var _drag_a := Vector2.ZERO
var _drag_b := Vector2.ZERO
var _panning := false

@onready var camera: Camera2D = $Camera
@onready var hud: Label = $UI/Hud


func _ready() -> void:
	var dir := site_from_args(OS.get_cmdline_user_args(), ProjectSettings.globalize_path("res://"))
	if dir != "":
		load_site(dir)
	else:
		status = "no site: run with -- --site=data/sites/<site>"
	_update_hud()


## Clears the selection and any gesture in progress (test harness hook).
func reset_scene() -> void:
	selected_id = ""
	_mode = Mode.IDLE
	_shadow_armed = false
	_panning = false
	queue_redraw()


## The --site=<path> user argument, resolved against `project_dir` when relative; "" if absent.
static func site_from_args(args: PackedStringArray, project_dir: String) -> String:
	for arg in args:
		if arg.begins_with("--site="):
			var path := arg.trim_prefix("--site=").replace("\\", "/")
			if path.is_absolute_path():
				return path.simplify_path()
			return project_dir.path_join(path).simplify_path()
	return ""


## Stable id like replica.rocks.rock_id: sha1 of the centre rounded to 0.5 m (half to even, as
## Python's round), first 12 hex digits.
static func rock_id(x: float, z: float) -> String:
	var key := "%.1f,%.1f" % [_round_half_even(x * 2.0) / 2.0 + 0.0, _round_half_even(z * 2.0) / 2.0 + 0.0]
	return key.sha1_text().substr(0, 12)


static func _round_half_even(v: float) -> float:
	var r := roundf(v)
	if absf(absf(v - floorf(v)) - 0.5) < 1e-9:
		r = 2.0 * roundf(v / 2.0)
	return r


## Rock geometry from a drag: `a` -> `b` is the long axis, `w` any point at the half-width from it.
## Returns {pos, length, width, yaw_deg}; the longer side is always the length.
static func drag_rock(a: Vector2, b: Vector2, w: Vector2) -> Dictionary:
	var axis := b - a
	var length := axis.length()
	var dir := axis / length if length > 0.0 else Vector2(0, -1)
	var width := 2.0 * absf(dir.cross(w - a))
	var yaw := fposmod(rad_to_deg(atan2(dir.x, -dir.y)), 180.0)
	if width > length:
		var t := length
		length = width
		width = t
		yaw = fposmod(yaw + 90.0, 180.0)
	return {"pos": (a + b) / 2.0, "length": length, "width": width, "yaw_deg": yaw}


## Loads a site directory (absolute path). Returns false if the rock list is missing.
func load_site(dir: String) -> bool:
	site_dir = dir
	detected.clear()
	added.clear()
	deleted.clear()
	changed.clear()
	selected_id = ""
	dirty = false
	_mode = Mode.IDLE
	ortho_texture = null
	var site: Variant = _read_json(dir.path_join("site.json"))
	if site is Dictionary:
		core_m = float(site.get("core_m", core_m))
		mpp = float(site.get("ortho_m_per_px", mpp))
		var sun: Variant = site.get("sun")
		if sun is Dictionary:
			sun_elevation_deg = float(sun.get("elevation_deg", sun_elevation_deg))
	var ortho_path := dir.path_join("build/ortho.png")
	if FileAccess.file_exists(ortho_path):
		var image := Image.load_from_file(ortho_path)
		if image:
			ortho_texture = ImageTexture.create_from_image(image)
	var data: Variant = _read_json(dir.path_join("build/rocks_detected.json"))
	if not (data is Dictionary and data.get("rocks") is Array):
		status = "missing build/rocks_detected.json in %s" % dir
		_rebuild()
		return false
	for r: Dictionary in data["rocks"]:
		detected.append(r)
	var edits: Variant = _read_json(dir.path_join("edits/rocks_edits.json"))
	if edits is Dictionary:
		for r: Dictionary in edits.get("added", []):
			added.append(r)
		for id: String in edits.get("deleted", []):
			deleted[id] = true
		var ch: Dictionary = edits.get("changed", {})
		for id: String in ch:
			changed[id] = ch[id]
	_fit_footprint_rule()
	_rebuild()
	fit_view()
	status = "loaded %d detected rocks, %d added, %d deleted, %d changed" % [
		detected.size(), added.size(), deleted.size(), changed.size()]
	return true


## Writes edits/rocks_edits.json (the only file this tool writes).
func save() -> bool:
	DirAccess.make_dir_recursive_absolute(site_dir.path_join("edits"))
	var del := deleted.keys()
	del.sort()
	var ids := changed.keys()
	ids.sort()
	var ch := {}
	for id: String in ids:
		ch[id] = changed[id]
	var out_added: Array = []
	for r in added:
		out_added.append(_ordered(r))
	var text := JSON.stringify({"added": out_added, "deleted": del, "changed": ch}, " ", false)
	var f := FileAccess.open(site_dir.path_join("edits/rocks_edits.json"), FileAccess.WRITE)
	if f == null:
		status = "save failed: %s" % error_string(FileAccess.get_open_error())
		_update_hud()
		return false
	f.store_string(text + "\n")
	f.close()
	dirty = false
	status = "saved edits/rocks_edits.json"
	_update_hud()
	return true


## Selects the rock under `p` (metres x, z); the smallest one if several. Returns its id or "".
func select_at(p: Vector2) -> String:
	var best := ""
	var best_area := INF
	for r in rocks:
		if _contains(r, p):
			var area := float(r["length"]) * float(r["width"])
			if area < best_area:
				best_area = area
				best = r["id"]
	selected_id = best
	queue_redraw()
	_update_hud()
	return best


## Deletes the selected rock: an added one is dropped from the edits, a detected one is recorded
## as deleted (and its changes forgotten).
func delete_selected() -> void:
	if selected_id == "":
		return
	var i := _added_index(selected_id)
	if i >= 0:
		added.remove_at(i)
	else:
		deleted[selected_id] = true
		changed.erase(selected_id)
	status = "deleted %s" % selected_id
	selected_id = ""
	dirty = true
	_rebuild()


## Adds a boulder (source "edit") and selects it; returns its id. `height` <= 0 applies the
## footprint rule (height_source "footprint"), otherwise it is a measurement ("shadow").
func add_rock(pos: Vector2, length: float, width: float, yaw_deg: float, height: float) -> String:
	if width > length:
		var t := length
		length = width
		width = t
		yaw_deg += 90.0
	var h := height
	var hs := "shadow"
	if h <= 0.0:
		h = footprint_height(width)
		hs = "footprint"
	var r := {
		"id": _unique_id(rock_id(pos.x, pos.y)),
		"x": _r2(pos.x), "z": _r2(pos.y),
		"length": _r2(length), "width": _r2(width), "yaw_deg": _r2(fposmod(yaw_deg, 180.0)),
		"height": _r2(clampf(h, HEIGHT_MIN, HEIGHT_MAX)),
		"kind": "boulder", "outline": null, "source": "edit", "height_source": hs,
	}
	added.append(r)
	selected_id = r["id"]
	dirty = true
	status = "added %s" % r["id"]
	_rebuild()
	return r["id"]


## Sets the selected rock's height (m), as a measurement (height_source "shadow").
func set_selected_height(height: float) -> void:
	if selected_id == "":
		return
	var h := _r2(clampf(height, HEIGHT_MIN, HEIGHT_MAX))
	var i := _added_index(selected_id)
	if i >= 0:
		added[i]["height"] = h
		added[i]["height_source"] = "shadow"
	else:
		var c: Dictionary = changed.get(selected_id, {})
		c["height"] = h
		c["height_source"] = "shadow"
		changed[selected_id] = c
	dirty = true
	status = "height %.2f m on %s" % [h, selected_id]
	_rebuild()


## Rock height (m) from a shadow length (m) on flat ground, with the site's sun elevation.
func height_from_shadow(shadow_m: float) -> float:
	return shadow_m * tan(deg_to_rad(sun_elevation_deg))


## The footprint rule's height for a rock this wide.
func footprint_height(width: float) -> float:
	return clampf(minf(width * _footprint_ratio, _footprint_cap), HEIGHT_MIN, HEIGHT_MAX)


func rock_by_id(id: String) -> Dictionary:
	for r in rocks:
		if r["id"] == id:
			return r
	return {}


## Frames the whole core in the window.
func fit_view() -> void:
	if not is_node_ready():
		return
	var size := get_viewport_rect().size
	camera.position = Vector2.ZERO
	var z := minf(size.x, size.y) / core_m * 0.95
	camera.zoom = Vector2(z, z)
	queue_redraw()


# --- model ------------------------------------------------------------------------------------


func _rebuild() -> void:
	rocks.clear()
	for r in detected:
		var id: String = r["id"]
		if deleted.has(id):
			continue
		if changed.has(id):
			var m := r.duplicate()
			m.merge(changed[id], true)
			m["source"] = "edit"
			rocks.append(m)
		else:
			rocks.append(r)
	for r in added:
		rocks.append(r)
	queue_redraw()
	_update_hud()


func _fit_footprint_rule() -> void:
	var ratios: Array[float] = []
	var heights: Array[float] = []
	for r in detected:
		if r.get("kind") == "boulder" and r.get("height_source") == "shadow" and float(r["width"]) > 0.0:
			ratios.append(float(r["height"]) / float(r["width"]))
			heights.append(float(r["height"]))
	_footprint_ratio = FOOTPRINT_HEIGHT_RATIO
	_footprint_cap = HEIGHT_MAX
	if ratios.size() >= FOOTPRINT_RATIO_MIN_SAMPLES:
		_footprint_ratio = _percentile(ratios, 50.0)
		_footprint_cap = _percentile(heights, FOOTPRINT_CAP_PERCENTILE)


## numpy-style linear-interpolation percentile.
static func _percentile(values: Array[float], q: float) -> float:
	var v := values.duplicate()
	v.sort()
	var pos := (v.size() - 1) * q / 100.0
	var lo := int(floorf(pos))
	var hi := mini(lo + 1, v.size() - 1)
	return lerpf(v[lo], v[hi], pos - lo)


func _unique_id(base: String) -> String:
	var used := {}
	for r in detected:
		used[r["id"]] = true
	for r in added:
		used[r["id"]] = true
	var id := base
	var n := 0
	while used.has(id):
		n += 1
		id = ("%s#%d" % [base, n]).sha1_text().substr(0, 12)
	return id


func _added_index(id: String) -> int:
	for i in added.size():
		if added[i]["id"] == id:
			return i
	return -1


func _contains(r: Dictionary, p: Vector2) -> bool:
	var outline: Variant = r.get("outline")
	if outline is Array and outline.size() >= 3:
		return Geometry2D.is_point_in_polygon(p, _poly(outline))
	var d := p - Vector2(r["x"], r["z"])
	var yaw := deg_to_rad(float(r["yaw_deg"]))
	var u := Vector2(sin(yaw), -cos(yaw))
	var v := Vector2(cos(yaw), sin(yaw))
	return absf(d.dot(u)) <= float(r["length"]) / 2.0 + PICK_MARGIN_M \
		and absf(d.dot(v)) <= float(r["width"]) / 2.0 + PICK_MARGIN_M


static func _corners(c: Vector2, length: float, width: float, yaw_deg: float) -> PackedVector2Array:
	var yaw := deg_to_rad(yaw_deg)
	var u := Vector2(sin(yaw), -cos(yaw)) * length / 2.0
	var v := Vector2(cos(yaw), sin(yaw)) * width / 2.0
	return PackedVector2Array([c + u + v, c + u - v, c - u - v, c - u + v])


static func _poly(outline: Array) -> PackedVector2Array:
	var out := PackedVector2Array()
	for pt: Array in outline:
		out.append(Vector2(pt[0], pt[1]))
	return out


static func _r2(v: float) -> float:
	return snappedf(v, 0.01)


static func _ordered(r: Dictionary) -> Dictionary:
	var out := {}
	for k in FIELDS:
		out[k] = r.get(k)
	return out


static func _read_json(path: String) -> Variant:
	if not FileAccess.file_exists(path):
		return null
	return JSON.parse_string(FileAccess.get_file_as_string(path))


# --- view & input -------------------------------------------------------------------------------


func _draw() -> void:
	var half := core_m / 2.0
	if show_ortho and ortho_texture:
		draw_texture_rect(ortho_texture, Rect2(-half, -half, core_m, core_m), false)
	else:
		draw_rect(Rect2(-half, -half, core_m, core_m), Color(0.15, 0.15, 0.13))
	draw_rect(Rect2(-half, -half, core_m, core_m), Color(1, 1, 1, 0.5), false, -1.0)
	var px := 1.0 / maxf(camera.zoom.x, 1e-6) if is_node_ready() else 1.0
	if show_rocks:
		for r in rocks:
			var colour := COLOUR_EDIT if r.get("source") == "edit" else (
				COLOUR_MASS if r.get("kind") == "mass" else COLOUR_BOULDER)
			_draw_rock(r, colour, -1.0)
	var sel := rock_by_id(selected_id)
	if not sel.is_empty():
		_draw_rock(sel, COLOUR_SELECTED, 2.5 * px)
	if _mode == Mode.AXIS or _mode == Mode.WIDTH:
		var w := _drag_b if _mode == Mode.AXIS else get_global_mouse_position()
		var g := drag_rock(_drag_a, _drag_b, w)
		draw_line(_drag_a, _drag_b, COLOUR_PREVIEW, 1.5 * px)
		if _mode == Mode.WIDTH:
			var poly := _corners(g["pos"], g["length"], g["width"], g["yaw_deg"])
			poly.append(poly[0])
			draw_polyline(poly, COLOUR_PREVIEW, 1.5 * px)
	elif _mode == Mode.SHADOW:
		draw_line(_drag_a, _drag_b, Color(0.4, 0.6, 1.0), 1.5 * px)


func _draw_rock(r: Dictionary, colour: Color, width: float) -> void:
	var poly: PackedVector2Array
	var outline: Variant = r.get("outline")
	if outline is Array and outline.size() >= 3:
		poly = _poly(outline)
	else:
		poly = _corners(Vector2(r["x"], r["z"]), float(r["length"]), float(r["width"]), float(r["yaw_deg"]))
	poly.append(poly[0])
	draw_polyline(poly, colour, width)


func _process(delta: float) -> void:
	var pan := Input.get_vector("ui_left", "ui_right", "ui_up", "ui_down")
	if Input.is_physical_key_pressed(KEY_A):
		pan.x -= 1.0
	if Input.is_physical_key_pressed(KEY_D):
		pan.x += 1.0
	if Input.is_physical_key_pressed(KEY_W):
		pan.y -= 1.0
	if Input.is_physical_key_pressed(KEY_S) and not Input.is_key_pressed(KEY_CTRL):
		pan.y += 1.0
	if pan != Vector2.ZERO:
		camera.position += pan.limit_length(1.0) * PAN_SPEED_PX * delta / camera.zoom.x
	if _mode == Mode.WIDTH or pan != Vector2.ZERO:
		queue_redraw()
	_update_hud()


func _unhandled_input(event: InputEvent) -> void:
	if event is InputEventMouseButton:
		_mouse_button(event)
	elif event is InputEventMouseMotion:
		_mouse_motion(event)
	elif event is InputEventKey and event.pressed and not event.echo:
		_key(event)


func _mouse_button(e: InputEventMouseButton) -> void:
	if e.button_index == MOUSE_BUTTON_WHEEL_UP or e.button_index == MOUSE_BUTTON_WHEEL_DOWN:
		if e.pressed:
			var before := get_global_mouse_position()
			var f := ZOOM_STEP if e.button_index == MOUSE_BUTTON_WHEEL_UP else 1.0 / ZOOM_STEP
			camera.zoom = (camera.zoom * f).clamp(Vector2.ONE * ZOOM_MIN, Vector2.ONE * ZOOM_MAX)
			camera.force_update_scroll()
			camera.position += before - get_global_mouse_position()
			queue_redraw()
		return
	if e.button_index == MOUSE_BUTTON_RIGHT or e.button_index == MOUSE_BUTTON_MIDDLE:
		_panning = e.pressed
		return
	if e.button_index != MOUSE_BUTTON_LEFT:
		return
	var p := get_global_mouse_position()
	if e.pressed:
		if _mode == Mode.WIDTH:
			var g := drag_rock(_drag_a, _drag_b, p)
			_mode = Mode.IDLE
			add_rock(g["pos"], g["length"], g["width"], g["yaw_deg"], next_height)
			return
		_press_screen = e.position
		_drag_a = p
		_drag_b = p
		_mode = Mode.SHADOW if _shadow_armed else Mode.PRESSED
	else:
		match _mode:
			Mode.PRESSED:
				_mode = Mode.IDLE
				select_at(p)
			Mode.AXIS:
				_mode = Mode.WIDTH if _drag_a.distance_to(_drag_b) >= mpp else Mode.IDLE
			Mode.SHADOW:
				_mode = Mode.IDLE
				_shadow_armed = false
				if selected_id != "":
					set_selected_height(height_from_shadow(_drag_a.distance_to(_drag_b)))
				else:
					status = "select a rock before measuring its shadow"
	queue_redraw()


func _mouse_motion(e: InputEventMouseMotion) -> void:
	if _panning:
		camera.position -= e.relative / camera.zoom.x
		return
	if _mode == Mode.PRESSED and e.position.distance_to(_press_screen) > DRAG_PX:
		_mode = Mode.AXIS
	if _mode == Mode.AXIS or _mode == Mode.SHADOW:
		_drag_b = get_global_mouse_position()
		queue_redraw()


func _key(e: InputEventKey) -> void:
	if e.keycode == KEY_S and e.ctrl_pressed:
		save()
		return
	match e.keycode:
		KEY_DELETE, KEY_BACKSPACE, KEY_X:
			delete_selected()
		KEY_ESCAPE:
			if _mode != Mode.IDLE or _shadow_armed:
				_mode = Mode.IDLE
				_shadow_armed = false
			else:
				selected_id = ""
			queue_redraw()
		KEY_F:
			fit_view()
		KEY_O:
			show_ortho = not show_ortho
			queue_redraw()
		KEY_L:
			show_rocks = not show_rocks
			queue_redraw()
		KEY_M:
			_shadow_armed = not _shadow_armed
			status = "drag from the rock's foot to its shadow tip" if _shadow_armed else ""
	if e.keycode >= KEY_0 and e.keycode <= KEY_9:
		var n := float(e.keycode - KEY_0)
		var h := 10.0 if n == 0.0 else n + (0.5 if e.shift_pressed else 0.0)
		if selected_id != "":
			set_selected_height(h)
		else:
			next_height = h
			status = "next rock height %.1f m" % h
	_update_hud()


func _notification(what: int) -> void:
	if what == NOTIFICATION_WM_CLOSE_REQUEST and dirty and site_dir != "":
		save()


func _update_hud() -> void:
	if not is_node_ready():
		return
	var p := get_global_mouse_position()
	var half := core_m / 2.0
	var lines: Array[String] = []
	lines.append("%s%s" % [site_dir if site_dir != "" else "(no site)", "  *unsaved*" if dirty else ""])
	lines.append("rocks %d   deleted %d   added %d   changed %d" % [rocks.size(), deleted.size(), added.size(), changed.size()])
	lines.append("cursor x %.1f  z %.1f   ortho px (%d, %d)" % [p.x, p.y, int((p.x + half) / mpp), int((p.y + half) / mpp)])
	var sel := rock_by_id(selected_id)
	if not sel.is_empty():
		lines.append("selected %s %s  %.1f x %.1f m  yaw %.0f  h %.1f m (%s, %s)" % [sel["id"], sel["kind"],
			float(sel["length"]), float(sel["width"]), float(sel["yaw_deg"]), float(sel["height"]),
			sel["height_source"], sel["source"]])
	else:
		lines.append("next new rock height: %s" % ("footprint rule" if next_height <= 0.0 else "%.1f m" % next_height))
	if _shadow_armed:
		lines.append("SHADOW: drag from the rock's foot to its shadow tip")
	if status != "":
		lines.append(status)
	lines.append("wheel zoom · RMB/MMB/WASD pan · F fit · click select · Del delete · drag axis, move, click = add rock")
	lines.append("1-9 height (Shift +0.5, 0 = 10) · M shadow height · O ortho · L rocks · Esc cancel · Ctrl+S save")
	hud.text = "\n".join(lines)
